# Runtime mode
SOURCE_CONFIG=source-fixture.yaml
# Auto mode uses OpenAI for the live phase when OPENAI_API_KEY is non-empty.
# The banked fixture phase always uses MODEL_MODE=fake.
EVIDENCE_MODE=
MODEL_MODE=auto
OPENAI_API_KEY=
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_TIMEOUT_SECONDS=60
# In-process retry delay. Valid range: 0.1 to 60 seconds.
PROCESSING_RETRY_BACKOFF_SECONDS=5
# Hard wall-clock lease for one retained record, including every retry.
# The worker exits before its Redpanda consumer ownership window expires.
PROCESSING_RETRY_MAX_ELAPSED_SECONDS=1800
# Redpanda consumer ownership window; mapped to the Kafka-protocol
# max.poll.interval.ms client property.
CONSUMER_MAX_POLL_INTERVAL_MS=3600000
HISTORY_PACKAGES=urllib3,requests,python-dateutil
HISTORY_RELEASES_PER_PACKAGE=2
HISTORY_TARGET_VERSIONS=
# The retained demo publishes only its four review surfaces, all on loopback.
REDPANDA_CONSOLE_PORT=8080
API_PORT=8000
WEB_PORT=3000
GRAFANA_PORT=3001

# Local database. Change both values together if overriding.
POSTGRES_DB=pypi_intelligence
POSTGRES_USER=pypi
POSTGRES_PASSWORD=pypi_local_only
DATABASE_URL=postgresql://pypi:pypi_local_only@postgres:5432/pypi_intelligence

# Internal service endpoints
REDPANDA_BROKERS=redpanda:9092
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Optional external browser URL for Grafana. Leave blank to derive the local
# browser URL from GRAFANA_PORT in Docker Compose.
GRAFANA_BASE_URL=

# Explicitly local-only model payload capture
DEPLOYMENT_ENV=local
OBS_CAPTURE_MODEL_PAYLOADS=false
