.git
.gitignore

# Never send local environments or credential material to the build daemon.
.env
.env.*
.envrc
.envrc.*
.direnv
*.pem
*.key
*.p12
*.pfx
*.ppk
*.jks
*.keystore
*.credentials
*.secret
*.secrets
id_rsa*
id_ed25519*
credentials.json
credentials-*.json
credentials_*.json
service-account*.json
service_account*.json
client_secret*.json
application_default_credentials.json
.aws
.azure
.kube
.docker/config.json
.npmrc
.pypirc
.netrc
.git-credentials
.terraform
*.tfstate
*.tfstate.backup
*.tfvars

# Local editor, agent, database, export, and temporary state.
.idea
.vscode
.cursor
.codex
.agents
.claude
.gemini
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
*.bak
backups
exports
tmp
.tmp

# Generated and cache content is restored inside reviewed build stages.
/build/.archive-*
/build/.pointer-*
/build/.rejected-*
/build/.retired-*
.DS_Store
.coverage
.uv-cache
.pnpm-store
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/node_modules
web/dist
dist
coverage
htmlcov
*.pyc
*.pyo
*.log
