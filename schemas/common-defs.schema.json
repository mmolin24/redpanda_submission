{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pypi-intelligence/schemas/common-defs.schema.json",
  "$defs": {
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "nullableDateTime": {
      "anyOf": [
        { "$ref": "#/$defs/dateTime" },
        { "type": "null" }
      ]
    },
    "processingAttemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "traceFlags": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}$"
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "normalized_name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "normalized_name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 256
        }
      }
    },
    "releaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "published_at", "url"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "published_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://pypi\\.org/project/"
        }
      }
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_attempt_id",
        "analysis_trace_id",
        "analysis_span_id",
        "trace_flags",
        "stage_summary"
      ],
      "properties": {
        "processing_attempt_id": {
          "$ref": "#/$defs/processingAttemptId"
        },
        "analysis_trace_id": {
          "$ref": "#/$defs/traceId"
        },
        "analysis_span_id": {
          "$ref": "#/$defs/spanId"
        },
        "trace_flags": {
          "$ref": "#/$defs/traceFlags"
        },
        "tracestate": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "stage_summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
