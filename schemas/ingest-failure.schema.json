{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pypi-intelligence/schemas/ingest-failure.schema.json",
  "title": "Source ingestion failure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "failure_id", "failure_fingerprint", "event_key", "stage", "error_class", "message", "retryable", "attempt_count", "first_failed_at", "last_failed_at", "next_retry_at", "payload", "observability"],
  "properties": {
    "schema_version": { "const": "failure.v1" },
    "failure_id": { "type": "string", "format": "uuid" },
    "failure_fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "event_key": { "type": "null" },
    "stage": { "const": "ingestion" },
    "error_class": { "enum": ["malformed_rss", "invalid_release_event"] },
    "message": { "type": "string", "minLength": 1, "maxLength": 512 },
    "retryable": { "const": false },
    "attempt_count": { "const": 1 },
    "first_failed_at": {
      "$ref": "file:///schemas/common-defs.schema.json#/$defs/dateTime"
    },
    "last_failed_at": {
      "$ref": "file:///schemas/common-defs.schema.json#/$defs/dateTime"
    },
    "next_retry_at": { "type": "null" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_kind",
        "content_sha256",
        "original_bytes",
        "captured_bytes",
        "snapshot_base64",
        "snapshot_encoding",
        "truncated",
        "source",
        "content_type"
      ],
      "properties": {
        "input_kind": { "enum": ["rss_document", "rss_item"] },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "original_bytes": { "type": "integer", "minimum": 0 },
        "captured_bytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "snapshot_base64": { "type": "string", "maxLength": 349528, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
        "snapshot_encoding": { "const": "base64" },
        "truncated": { "type": "boolean" },
        "source": { "const": "pypi-rss-updates" },
        "content_type": { "enum": ["application/rss+xml", "application/xml", "text/xml", "application/json"] },
        "error_source_name": { "type": ["string", "null"], "maxLength": 128 },
        "error_source_label": { "type": ["string", "null"], "maxLength": 128 },
        "error_source_path": { "type": ["string", "null"], "maxLength": 256 },
        "title_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "link_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "observability": {
      "$ref": "file:///schemas/common-defs.schema.json#/$defs/traceContext"
    }
  }
}
