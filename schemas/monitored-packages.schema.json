{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.pypi-intelligence/schemas/monitored-packages.schema.json",
  "title": "Monitored PyPI packages",
  "type": "object",
  "additionalProperties": false,
  "required": ["packages"],
  "properties": {
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 256
      }
    }
  }
}
